# PAMASMMA v4.1 — Environment template
APP_ENV=production
DEBUG=false

SECRET_KEY=generate-a-long-random-secret
PAMASMMA_BOOTSTRAP_TOKEN=generate-a-separate-enrollment-token

PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
REDIS_URL=redis://user:password@host:6379/0
SCHEDULER_ENABLED=true

# Provider-neutral intelligence
# kernel requires no model API key.
MODEL_PROVIDER=kernel
MODEL_NAME=llama3.2:3b
MODEL_API_BASE_URL=
MODEL_API_KEY=

# Optional cloud model adapter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local embeddings require no OpenAI key.
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

WEBAUTHN_RP_ID=pamasmma.app
WEBAUTHN_RP_NAME=PAMASMMA
WEBAUTHN_ORIGIN=https://pamasmma.app

ALLOWED_ORIGINS=["http://localhost:3000"]

SCHEDULER_TIMEZONE=Africa/Nairobi
