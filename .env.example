# ─────────────────────────────────────────────
# PAMASMMA — Environment Variable Reference
# Copy to .env and fill in values before running
# Never commit .env to version control
# ─────────────────────────────────────────────

# ── Orchestrator ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── Kafka (event bus) ─────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pamasmma-orchestrator
KAFKA_GROUP_ID=pamasmma-consumers

# ── Marketing Intel service ───────────────────
MARKETING_INTEL_PORT=3005

# ── Tool Gateway ──────────────────────────────
TOOL_GATEWAY_PORT=3003

# ── OpenTelemetry / Tracing ───────────────────
OTEL_SERVICE_NAME=pamasmma-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Memory / Persistence ─────────────────────
# DATABASE_URL=postgres://user:password@localhost:5432/pamasmma

# ── Security ─────────────────────────────────
# JWT_SECRET=change-me-in-production
# API_KEY=change-me-in-production

# ── Logging ───────────────────────────────────
LOG_LEVEL=info
