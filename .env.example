# PAMASMMA v4.1 — Local development template
APP_ENV=development
DEBUG=true

SECRET_KEY=replace-with-a-long-random-development-secret
PAMASMMA_BOOTSTRAP_TOKEN=replace-with-a-development-bootstrap-token

PERSISTENCE_MODE=memory
DATABASE_URL=
REDIS_URL=
SCHEDULER_ENABLED=false

MODEL_PROVIDER=kernel
MODEL_NAME=llama3.2:3b
MODEL_API_BASE_URL=
MODEL_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PAMASMMA
WEBAUTHN_ORIGIN=http://localhost:3000

ALLOWED_ORIGINS=["http://localhost:3000"]

SCHEDULER_TIMEZONE=Africa/Nairobi

# Knowledge Training
KNOWLEDGE_MAX_UPLOAD_MB=100
KNOWLEDGE_MAX_ARCHIVE_EXTRACT_MB=250
KNOWLEDGE_MAX_ARCHIVE_FILES=2000
KNOWLEDGE_MAX_CHUNKS_PER_SOURCE=10000
KNOWLEDGE_MEMORY_SOURCE_LIMIT=25
KNOWLEDGE_MEMORY_CHUNK_LIMIT=1000
KNOWLEDGE_CHUNK_SIZE=420
KNOWLEDGE_CHUNK_OVERLAP=60
KNOWLEDGE_SIMILARITY_THRESHOLD=0.68
KNOWLEDGE_TRANSCRIPTION_PROVIDER=openai
KNOWLEDGE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
KNOWLEDGE_MEDIA_TIMEOUT_SECONDS=900

# Social Growth Platform Integrations
# Configure only the platforms you intend to connect; secrets must never be committed.
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_META_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/facebook/callback
SOCIAL_META_GRAPH_VERSION=v23.0
SOCIAL_META_SCOPES=pages_manage_posts,pages_read_engagement,pages_read_user_content,instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_insights,ads_read,ads_management

SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/tiktok/callback
SOCIAL_TIKTOK_SCOPES=user.info.basic,video.publish

SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/youtube/callback
SOCIAL_YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.force-ssl https://www.googleapis.com/auth/yt-analytics.readonly

SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/linkedin/callback
SOCIAL_LINKEDIN_SCOPES=openid profile w_member_social
SOCIAL_LINKEDIN_VERSION=202609

SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_X_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/x/callback
SOCIAL_X_SCOPES=tweet.read tweet.write users.read offline.access

SOCIAL_THREADS_CLIENT_ID=
SOCIAL_THREADS_CLIENT_SECRET=
SOCIAL_THREADS_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/threads/callback
SOCIAL_THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_replies

SOCIAL_PINTEREST_APP_ID=
SOCIAL_PINTEREST_APP_SECRET=
SOCIAL_PINTEREST_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/pinterest/callback
SOCIAL_PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write

SOCIAL_REDDIT_CLIENT_ID=
SOCIAL_REDDIT_CLIENT_SECRET=
SOCIAL_REDDIT_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/reddit/callback
SOCIAL_REDDIT_SCOPES=identity,submit,read,comment

SOCIAL_TELEGRAM_BOT_TOKEN=
SOCIAL_WHATSAPP_ACCESS_TOKEN=
SOCIAL_AUTOPILOT_ENABLED=false
SOCIAL_ADS_AUTONOMOUS_ENABLED=false
