# ── Orchestrator ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Comma-separated list of valid Bearer tokens.
# In development: leave unset to allow all requests (a warning will be logged).
# In production:  MUST be set. Requests without a matching token receive 403.
# Example:  API_KEYS=prod-key-1,prod-key-2
API_KEYS=

# ── Persistence ───────────────────────────────────────────────────────────────
# Path for the SQLite database file used by SqliteTaskStore and SqliteLongTermMemory.
# Use ':memory:' in tests for a zero-cleanup in-process database.
# Default: ./pamasmma.db
DATABASE_PATH=./pamasmma.db

# ── Observability ─────────────────────────────────────────────────────────────
# OTLP endpoint for the OTel trace exporter (see infra/otel-collector-config.yml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Kafka (future — wired in when you swap LocalEventBus for KafkaProducer) ──
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=pamasmma-orchestrator
