# PAMASMMA v4 — Environment Variables
# Copy to .env and populate all values before running.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your_64_char_hex_secret_key_here

# ── Database (Supabase) ───────────────────────────────────────────────────────
# From: Supabase → Project Settings → Database → Connection string (URI)
# Use transaction mode for Railway: port 6543
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# From: Upstash → Database → Connect → .env
REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6380

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (embeddings only) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── WebAuthn ─────────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=pamasmma.app
WEBAUTHN_RP_NAME=PAMASMMA
WEBAUTHN_ORIGIN=https://pamasmma.app

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON list of allowed origins
ALLOWED_ORIGINS=["https://pamasmma.app","https://www.pamasmma.app"]

# ── Railway (deploy) ─────────────────────────────────────────────────────────
# From: Railway → Account Settings → Tokens
RAILWAY_TOKEN=your_railway_token_here

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.pamasmma.app/api/v1
