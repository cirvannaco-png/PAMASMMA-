# PAMASMMA v4.1 — Local development template
APP_ENV=development
DEBUG=true

SECRET_KEY=replace-with-a-long-random-development-secret
PAMASMMA_BOOTSTRAP_TOKEN=replace-with-a-development-bootstrap-token

PERSISTENCE_MODE=memory
DATABASE_URL=
REDIS_URL=
SCHEDULER_ENABLED=false

MODEL_PROVIDER=kernel
MODEL_NAME=llama3.2:3b
MODEL_API_BASE_URL=
MODEL_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PAMASMMA
WEBAUTHN_ORIGIN=http://localhost:3000

ALLOWED_ORIGINS=["http://localhost:3000"]

SCHEDULER_TIMEZONE=Africa/Nairobi
